{
  "name": "spearcode",
  "version": "0.1.1",
  "description": "Standalone AI coding agent for the terminal — 51 tools, 31 models. Optional Gungnir integration.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gungnir": {
      "types": "./dist/gungnir/index.d.ts",
      "default": "./dist/gungnir/index.js"
    }
  },
  "bin": {
    "spearcode": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "coding",
    "agent",
    "cli",
    "terminal",
    "claude",
    "gpt",
    "openrouter",
    "llm",
    "code-assistant",
    "developer-tools",
    "gungnir"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinggraphiste-hub/spearcode"
  },
  "homepage": "https://github.com/kevinggraphiste-hub/spearcode#readme",
  "bugs": {
    "url": "https://github.com/kevinggraphiste-hub/spearcode/issues"
  },
  "license": "Apache-2.0",
  "author": "SpearCode",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "build:bin": "node scripts/build-bin.mjs",
    "pack:linux": "node scripts/pack-linux.mjs",
    "pack:macos": "node scripts/pack-macos.mjs",
    "pack:windows": "node scripts/pack-windows.mjs",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.7.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "glob": "^11.0.1",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^6.14.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "preferGlobal": true
}
